#!/usr/bin/env bash
# Configure the approved SSH route with operator host-key pinning.
set -euo pipefail
umask 077
account=sy-agent
if [[ ${1:-} == --user && $# == 2 ]]; then account=$2
elif [[ $# != 0 ]]; then echo 'Usage: configure-client [--user ACCOUNT]' >&2; exit 2; fi
[[ $account =~ ^[a-zA-Z0-9_.-]+$ ]] || { echo 'Invalid account name' >&2; exit 1; }
# Ordinary installed hosts use safeyolo. Native agent setup has already staged
# the matching Linux safeyolo-coord executable under the agent's own home.
cli=${SAFEYOLO_SSH_PROXY_EXECUTABLE:-${SAFEYOLO_CLI:-}}
if [[ -z $cli ]]; then cli=$(command -v safeyolo || command -v safeyolo-coord || true); fi
if [[ -z $cli && -x $HOME/.safeyolo/safeyolo-coord ]]; then cli=$HOME/.safeyolo/safeyolo-coord; fi
[[ -n $cli && -x $cli ]] || { echo 'Native SSH proxy executable is missing; use the installed host CLI or the matching staged Linux Coord executable' >&2; exit 1; }
cli=$(cd -- "$(dirname -- "$cli")" && pwd)/$(basename -- "$cli")
identity_line=$("$cli" --version)
case "$identity_line" in
  'safeyolo '*|'safeyolo-coord '*) ;;
  *) echo 'Selected executable is not the native SafeYolo CLI/Coord runtime' >&2; exit 1;;
esac
"$cli" ssh-proxy --help >/dev/null
read -r -p 'Operator-approved Mac host/IP, as seen by the proxy: ' host
read -r -p 'SSH port [22]: ' port
port=${port:-22}
[[ $host =~ ^[A-Za-z0-9_.:-]+$ && $host != -* && $port =~ ^[0-9]+$ && ${#port} -le 5 ]] || { echo 'Invalid SSH host or port' >&2; exit 1; }
((10#$port >= 1 && 10#$port <= 65535)) || { echo 'Port must be between 1 and 65535' >&2; exit 1; }
read -r -p 'Mac SSH host public-key line: ' host_key
[[ $host_key == 'ssh-ed25519 '* && $host_key != *$'\r'* ]] || { echo 'Paste the single ssh-ed25519 host public-key line' >&2; exit 1; }
root=$HOME/.ssh/seatbelt-agent
identity=$HOME/.ssh/id_ed25519_sy_agent
[[ -f $identity && -f $identity.pub ]] || { echo 'Create the client key first using README step 1' >&2; exit 1; }
public=$(ssh-keygen -y -P '' -f "$identity" | awk '{print $1 " " $2}')
[[ $public == "$(awk '{print $1 " " $2}' "$identity.pub")" ]] || { echo 'Client private/public key pair does not match' >&2; exit 1; }
ssh_quote() {
  local value=$1
  [[ $value != *['"\']* && $value != *$'\n'* && $value != *$'\r'* ]] || { echo 'SSH path contains quotes, backslashes or newlines' >&2; return 1; }
  printf '"%s"' "${value//%/%%}"
}
shell_quote() {
  local value=${1//%/%%}
  printf "'%s'" "${value//\'/\'\"\'\"\'}"
}
mkdir -p "$root"
stage=$(mktemp -d "$root/client.XXXXXX")
trap 'rm -rf -- "$stage"' EXIT
printf '%s\n' "$host_key" > "$stage/host-key.pub"
ssh-keygen -lf "$stage/host-key.pub"
printf 'seatbelt-mac %s\n' "$host_key" > "$stage/known_hosts"
cat > "$stage/config" <<EOF
Host seatbelt-mac
    HostName $host
    Port $port
    User $account
    IdentityFile $(ssh_quote "$identity")
    IdentitiesOnly yes
    BatchMode yes
    StrictHostKeyChecking yes
    HostKeyAlias seatbelt-mac
    UserKnownHostsFile $(ssh_quote "$root/known_hosts")
    GlobalKnownHostsFile /dev/null
    ProxyCommand $(shell_quote "$cli") ssh-proxy %h %p
EOF
ssh -G -F "$stage/config" seatbelt-mac >/dev/null
for name in known_hosts config; do
  if [[ -f $root/$name ]]; then cp "$root/$name" "$root/$name.before"; chmod 600 "$root/$name.before"; fi
  chmod 600 "$stage/$name"
  mv -f "$stage/$name" "$root/$name"
done
printf 'Configured. Test: ssh -F %q seatbelt-mac id\n' "$root/config"
