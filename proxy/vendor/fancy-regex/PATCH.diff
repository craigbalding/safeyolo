+// SafeYolo patch: grow per-search buffers fallibly. No subject or pattern is
+// retained in the allocation error.
+fn reserve<T>(values: &mut Vec<T>, additional: usize) -> Result<()> {
+    values.try_reserve(additional)
+        .map_err(|_| Error::RuntimeError(RuntimeError::AllocationFailed))
+}
+
+fn resize<T: Clone>(values: &mut Vec<T>, len: usize, fill: T) -> Result<()> {
+    reserve(values, len.saturating_sub(values.len()))?;
+    values.resize(len, fill);
+    Ok(())
+}
+
+fn copy_saves(values: &[usize]) -> Result<Vec<usize>> {
+    let mut result = Vec::new();
+    reserve(&mut result, values.len())?;
+    result.extend_from_slice(values);
+    Ok(result)
+}
+
+struct ScratchRun<'a> {
+    scratch: &'a mut Scratch,
+    release: bool,
+}
+
+impl Drop for ScratchRun<'_> {
+    fn drop(&mut self) {
+        if self.release {
+            self.scratch.state.saves = Vec::new();
+            self.scratch.state.stack = Vec::new();
+            self.scratch.state.oldsave = Vec::new();
+            self.scratch.state.cut_scratch = Vec::new();
+            self.scratch.inner_slots = Vec::new();
+        }
+    }
+}
