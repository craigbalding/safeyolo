  "trailer_validation_patch": {
    "base_commit": "33682df1e4a8c5ae113b3d4f141c77b7c52a8afc",
    "seed_response_patch_sha256": "b0d7ca9863c3a815ebc87a8dea618465bf5c25daf0396ee3876616556e6ef30b",
    "seed_request_corrected_patch_sha256": "08c95372533c404b2a6ee4a592b4d2b1ce3f1b9dd961461b5f0af4af322ca8f1",
    "scope": "Reject request and response trailer blocks marked over the existing configured header-list limit with connection GOAWAY ENHANCE_YOUR_CALM (11), then reject any retained pseudo fields with GOAWAY PROTOCOL_ERROR (1), before receive close, body-length validation, field discard or completion. The size check also covers pseudo fields HPACK discarded after reaching the limit. No configured limit, initial-header behavior, DATA handling, reset handling or terminal-result ownership changes.",
    "files": [
      {
        "path": "src/proto/streams/recv.rs",
        "before_sha256": "dc9fadc3bcd990fb8d7761d390048779af58443a41d03f73d784a720ee4049fb",
        "after_sha256": "9d666cca08f5cc6345df02fb1722023888f084e2a63ec5b773282516b74dc374"
      }
    ],
    "validation": [
      "proxy/tests/request_completion_h2.rs",
      "proxy/tests/response_completion_h2.rs"
    ],
    "source_correlation": "Configured Python source rejects pseudo :path trailers with PROTOCOL_ERROR before request EOM and origin contact. Its existing HPACK decoder rejects oversized blocks before trailer validation with ENHANCE_YOUR_CALM. Native protocol tests establish completion abort, body error, accepted prefix preservation and connection error scope; application effects are a separate integration gate."
  },
