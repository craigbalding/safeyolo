  "response_raw_reason_patch": {
    "base_commit": "99bb0df9a481f550b0623722a999c6e8775e6a02",
    "seed": "frozen response_head_capture_patch",
    "scope": "After httparse Status::Complete only, recover the already validated status-line reason byte span. Preserve obs-text in the existing ReasonPhrase extension and response-head callback. No grammar, header, body, status, HTTP/0.9 fallback, or H2 changes; existing delimiter configuration remains authoritative.",
    "source_detail": "httparse 1.10.1 parse_reason validates obs-text but returns an empty str; byte recovery is bounded to the accepted head and never runs on partial/error/HTTP0.9 paths.",
