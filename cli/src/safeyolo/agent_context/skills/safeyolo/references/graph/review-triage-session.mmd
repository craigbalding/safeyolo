flowchart TD
    %% Auto-generated by scripts/render_skill_graph.py -- do not edit.

    classDef symptom fill:#ffe0e0,stroke:#a44
    classDef evidence fill:#e0e8ff,stroke:#446
    classDef classification fill:#fff2cc,stroke:#996
    classDef conclusion fill:#e0ffe0,stroke:#484
    classDef operator_ask fill:#f0d0ff,stroke:#748

    sym.review_recent_session(["Operator invoked /safeyolo-graph with no session id; review the most recent Claude Code session jsonl"])
    sym.review_specific_session(["Operator named a specific session jsonl path or session id"])
    sym.review_focus_on_graph(["Operator asked to focus the review on one specific triage graph (e.g. '--graph triage-request-failing')"])
    sym.review_no_session_available(["No session jsonl can be located; nothing to review"])
    ev.review_locate_jsonl["Resolve the session file: 'find ~/.claude/projects -name '*.jsonl' -type f -printf '%T@ %p\n' / sort -n / tail -1 / awk '{print $2}'' for most-recent, or use the operator-supplied path"]
    ev.review_parse_events["Parse jsonl line-by-line; filter to 'type in {user, assistant}' events; inspect 'message.content' blocks for 'text', 'tool_use', 'tool_result'"]
    ev.review_extract_skill_use["Find tool_use blocks where 'name == Skill' and 'args' reference 'safeyolo'"]
    ev.review_extract_graph_names["Find any assistant text or tool_use naming a 'triage-*.yaml' file"]
    ev.review_extract_node_ids["Regex assistant text for '\b(sym/ev/cls/con/ask)\.[a-z0-9_]+' — nodes the agent actually cited"]
    ev.review_identify_terminal["Determine whether the traversal named a 'con.*' conclusion or 'ask.*' operator ask at the end"]
    ev.review_look_for_graph_gap["Search for explicit 'Graph gap' narration and any proposed missing node/edge"]
    ev.review_load_referenced_graphs["Read the actual YAML at '~/.claude/skills/safeyolo/references/graph/*.yaml' for each graph the session referenced; you'll need real node IDs before proposing edits"]
    ev.review_reconstruct_failure["Reconstruct what the failure actually was from the session — status codes, response bodies, X-Blocked-By values, /explain output"]
    ev.review_check_operator_interventions["Note where the operator manually did something the agent couldn't (approvals, package installs, policy edits)"]
    cls.review_graph_gap{{"graph_gap: the graph did not cover this failure; agent had to guess or work around a missing edge"}}
    cls.review_correct_safeyolo_defect{{"graph_correct_safeyolo_defect: the graph led to a correct diagnosis and the diagnosis names a real SafeYolo defect (dead-lettered rules, missing classifiers, structural traps agents hit)"}}
    cls.review_graph_overfit{{"graph_overfit: the graph forced a longer/wrong path when a shorter diagnosis existed"}}
    cls.review_env_or_operator{{"environment_or_operator_issue: nothing to change; user misread normal behaviour, or environment was transient"}}
    cls.review_mixed{{"mixed: more than one of the above; each must be broken out separately"}}
    con.review_no_action(["No action required. Traversal was correct, no defect surfaced. Write the review and stop."])
    con.review_propose_graph_edit(["Produce a concrete YAML diff for the affected 'references/graph/triage-*.yaml'. Reference real node IDs read from the YAML."])
    con.review_report_safeyolo_defect(["Write a defect report: symptom one-liner, quoted evidence, minimum reproduction, likely SafeYolo source location, suggested severity"])
    con.review_propose_prune(["Flag pruning or edge-condition tightening candidates. Lower priority than gap-fill; note but do not urge."])
    ask.review_operator_reviews_edit[["Operator reviews the proposed YAML diff and decides whether to commit"]]
    ask.review_operator_files_defect[["Operator files the reported SafeYolo defect (issue tracker / PR) or triages it further"]]

    sym.review_recent_session -->|"next_check"| ev.review_locate_jsonl
    sym.review_specific_session -->|"next_check"| ev.review_locate_jsonl
    sym.review_focus_on_graph -->|"next_check"| ev.review_locate_jsonl
    sym.review_no_session_available -->|"implies"| con.review_no_action
    ev.review_locate_jsonl -->|"next_check"| ev.review_parse_events
    ev.review_parse_events -->|"next_check"| ev.review_extract_skill_use
    ev.review_parse_events -->|"next_check"| ev.review_extract_graph_names
    ev.review_parse_events -->|"next_check"| ev.review_extract_node_ids
    ev.review_parse_events -->|"next_check"| ev.review_identify_terminal
    ev.review_parse_events -->|"next_check"| ev.review_look_for_graph_gap
    ev.review_parse_events -->|"next_check"| ev.review_reconstruct_failure
    ev.review_parse_events -->|"next_check"| ev.review_check_operator_interventions
    ev.review_extract_graph_names -->|"next_check: at least one graph file was referenced"| ev.review_load_referenced_graphs
    ev.review_identify_terminal -->|"implies: no bounded terminal was reached AND explicit or implicit Graph gap AND no reasonable entry existed for the observed symptom"| cls.review_graph_gap
    ev.review_identify_terminal -->|"implies: bounded terminal was reached AND the reconstructed failure names a genuine SafeYolo defect that the terminal correctly points at"| cls.review_correct_safeyolo_defect
    ev.review_identify_terminal -->|"implies: bounded terminal was reached BUT the traversal was longer than necessary OR routed via classifications that added no signal for this specific failure"| cls.review_graph_overfit
    ev.review_identify_terminal -->|"implies: the failure was transient / normal environment behaviour misread by the agent; graph and safeyolo both correct"| cls.review_env_or_operator
    ev.review_identify_terminal -->|"implies: multiple of the above apply; each is separately grounded in evidence"| cls.review_mixed
    ev.review_reconstruct_failure -->|"rules_out: the reviewer has not yet loaded the referenced graphs; classification cannot proceed without knowing what the graph did/didn't cover"| ev.review_load_referenced_graphs
    cls.review_graph_gap -->|"implies"| con.review_propose_graph_edit
    cls.review_graph_gap -->|"escalates_to"| ask.review_operator_reviews_edit
    cls.review_correct_safeyolo_defect -->|"implies"| con.review_report_safeyolo_defect
    cls.review_correct_safeyolo_defect -->|"escalates_to"| ask.review_operator_files_defect
    cls.review_graph_overfit -->|"implies"| con.review_propose_prune
    cls.review_graph_overfit -->|"escalates_to"| ask.review_operator_reviews_edit
    cls.review_env_or_operator -->|"implies"| con.review_no_action
    cls.review_mixed -->|"implies: at least one graph_gap or graph_overfit component"| con.review_propose_graph_edit
    cls.review_mixed -->|"implies: at least one graph_correct_safeyolo_defect component"| con.review_report_safeyolo_defect
    ev.review_check_operator_interventions -->|"implies: the operator had to do something the graph never suggested; that intervention is a candidate future entry symptom / operator_ask"| con.review_propose_graph_edit

    class sym.review_recent_session symptom
    class sym.review_specific_session symptom
    class sym.review_focus_on_graph symptom
    class sym.review_no_session_available symptom
    class ev.review_locate_jsonl evidence
    class ev.review_parse_events evidence
    class ev.review_extract_skill_use evidence
    class ev.review_extract_graph_names evidence
    class ev.review_extract_node_ids evidence
    class ev.review_identify_terminal evidence
    class ev.review_look_for_graph_gap evidence
    class ev.review_load_referenced_graphs evidence
    class ev.review_reconstruct_failure evidence
    class ev.review_check_operator_interventions evidence
    class cls.review_graph_gap classification
    class cls.review_correct_safeyolo_defect classification
    class cls.review_graph_overfit classification
    class cls.review_env_or_operator classification
    class cls.review_mixed classification
    class con.review_no_action conclusion
    class con.review_propose_graph_edit conclusion
    class con.review_report_safeyolo_defect conclusion
    class con.review_propose_prune conclusion
    class ask.review_operator_reviews_edit operator_ask
    class ask.review_operator_files_defect operator_ask

    %% Entry symptoms (bind an observed symptom here)
    style sym.review_recent_session stroke-width:3px
    style sym.review_specific_session stroke-width:3px
    style sym.review_focus_on_graph stroke-width:3px
    style sym.review_no_session_available stroke-width:3px
