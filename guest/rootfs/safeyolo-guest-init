#!/bin/bash
#
# SafeYolo guest init STUB — baked into rootfs, rarely changes.
#
# Mounts the VirtioFS config share and execs the real init from there.
# All SafeYolo-specific logic lives on the config share so it can be
# updated without rebuilding the rootfs.
#
set -e

# Establish the VZ process capability at the immutable PID 1 boundary before
# any VirtioFS-hosted boot code runs.  The config-share orchestrator repeats
# and verifies this for compatibility with already-built rootfs images, but a
# fresh image must not depend on mutable share contents for its initial rlimit.
_nofile_limit=65536
if ! ulimit -n "$_nofile_limit"; then
    echo "FATAL: unable to establish RLIMIT_NOFILE=${_nofile_limit}/${_nofile_limit}" >&2
    exec sleep infinity
fi
_nofile_soft=$(ulimit -Sn)
_nofile_hard=$(ulimit -Hn)
if [ "$_nofile_soft" != "$_nofile_limit" ] || [ "$_nofile_hard" != "$_nofile_limit" ]; then
    echo "FATAL: RLIMIT_NOFILE is ${_nofile_soft}/${_nofile_hard}; expected ${_nofile_limit}/${_nofile_limit}" >&2
    exec sleep infinity
fi
unset _nofile_limit _nofile_soft _nofile_hard

# Mount minimal filesystems needed for VirtioFS
mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sys /sys 2>/dev/null || true
mount -t devtmpfs dev /dev 2>/dev/null || true
mkdir -p /dev/pts
mkdir -p /dev/shm /run /tmp
mount -t devpts devpts /dev/pts -o gid=5,mode=620,ptmxmode=666 2>/dev/null || true
ln -sf pts/ptmx /dev/ptmx 2>/dev/null || true
mount -t tmpfs tmpfs /dev/shm -o mode=1777,nosuid,nodev 2>/dev/null || true
mount -t tmpfs tmpfs /tmp -o mode=1777,nosuid,nodev 2>/dev/null || true
mount -t tmpfs tmpfs /run -o mode=755,nosuid,nodev 2>/dev/null || true

# Mount config share (contains the real init script, vsock-term, env files)
mkdir -p /safeyolo
mount -t virtiofs config /safeyolo 2>/dev/null || {
    echo "FATAL: cannot mount config share" >&2
    exec sleep infinity
}

# Hand off to the real init from the config share
if [ -x /safeyolo/guest-init ]; then
    exec /safeyolo/guest-init
else
    echo "FATAL: /safeyolo/guest-init not found on config share" >&2
    exec sleep infinity
fi
