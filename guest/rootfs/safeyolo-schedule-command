#!/bin/sh
# Match Debian scheduling commands on gVisor's nosuid filesystem. The agent
# already has these guest-local capabilities, as with safeyolo-sudo. Keep the
# real uid so the distro tools retain job ownership and their normal interface.
set -eu
command_name=${0##*/}
case "$command_name" in
    crontab) set -- --egid=crontab --keep-groups /usr/bin/crontab "$@" ;;
    at|atq|atrm|batch) set -- --euid=daemon --egid=daemon --keep-groups "/usr/bin/$command_name" "$@" ;;
    *) echo "Unsupported scheduling command: $command_name" >&2; exit 2 ;;
esac

# Without capabilities, the native commands use set-ID bits in VZ or the
# agent's supplementary spool groups in gVisor daemon children.
case "$command_name" in
    crontab) /usr/bin/setpriv --egid=crontab --keep-groups /bin/true 2>/dev/null && exec /usr/bin/setpriv "$@" ;;
    *) /usr/bin/setpriv --euid=daemon --egid=daemon --keep-groups /bin/true 2>/dev/null && exec /usr/bin/setpriv "$@" ;;
esac
while [ "$1" != "/usr/bin/$command_name" ]; do shift; done
exec "$@"
