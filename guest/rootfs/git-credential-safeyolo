#!/usr/bin/env python3
"""
git-credential-safeyolo — Git credential helper that returns SafeYolo synthetic
credentials for services the agent is authorized to reach.

Git calls credential helpers with a verb argument (`get`, `store`, `erase`) and
a stdin body of `key=value` lines terminated by an empty line. For a `get`
request we:

  1. Read the incoming request (protocol + host).
  2. Fetch this agent's authorized services from the Agent API
     (`/gateway/services`), authenticated with the token at /app/agent_token.
  3. If a service is bound to the requested host and has a service-gateway
     credential (an `sgw_...` token), print it back to git as
     `username=safeyolo\npassword=sgw_...\n`.
  4. On `store` / `erase` we do nothing — the token lifecycle is owned by the
     gateway, not by git's own credential cache.

The real credential (PAT / OAuth token) is resolved inside the proxy after
policy + operator approval; the agent process only ever sees the sgw_ token.
"""

from __future__ import annotations

import json
import sys
import urllib.error
import urllib.request

AGENT_API_URL = "http://_safeyolo.proxy.internal/gateway/services"
AGENT_TOKEN_PATH = "/app/agent_token"
TIMEOUT_SECONDS = 5.0

# Which usernames we accept as "yes, please substitute". Empty username is the
# common case (git prompts before knowing one). Any explicit non-empty value
# other than "safeyolo" is treated as the operator having configured a different
# credential path, and we pass through silently.
_ACCEPTED_USERNAMES = frozenset({"", "safeyolo"})


def _read_git_request() -> dict[str, str]:
    """Parse the key=value block git writes to stdin for a credential request."""
    request: dict[str, str] = {}
    for line in sys.stdin:
        line = line.rstrip("\n")
        if not line:
            break
        key, sep, value = line.partition("=")
        if sep:
            request[key] = value
    return request


def _load_agent_token() -> str | None:
    try:
        with open(AGENT_TOKEN_PATH, encoding="ascii") as f:
            return f.read().strip()
    except OSError:
        return None


def _fetch_gateway_services(token: str) -> dict | None:
    req = urllib.request.Request(
        AGENT_API_URL,
        headers={"Authorization": f"Bearer {token}"},
    )
    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT_SECONDS) as resp:  # noqa: S310 — internal URL
            body = resp.read().decode("utf-8", errors="strict")
    except (urllib.error.URLError, TimeoutError, OSError):
        return None
    try:
        return json.loads(body)
    except json.JSONDecodeError:
        return None


def _find_sgw_token_for_host(services_response: dict, host: str) -> str | None:
    """Look through the agent's authorized services for one bound to `host`."""
    authorized = services_response.get("authorized", {})
    if not isinstance(authorized, dict):
        return None
    host_lower = host.lower()
    for binding in authorized.values():
        if not isinstance(binding, dict):
            continue
        binding_host = str(binding.get("host", "")).lower()
        sgw_token = binding.get("token", "")
        if binding_host == host_lower and isinstance(sgw_token, str) and sgw_token.startswith("sgw_"):
            return sgw_token
    return None


def _handle_get() -> int:
    request = _read_git_request()
    host = request.get("host", "")
    username = request.get("username", "")
    protocol = request.get("protocol", "")

    if not host:
        return 0  # Nothing to answer — git will try the next helper / prompt.
    if protocol and protocol != "https":
        return 0  # Only intercept HTTPS; SafeYolo doesn't proxy plain git://.
    if username not in _ACCEPTED_USERNAMES:
        return 0

    agent_token = _load_agent_token()
    if not agent_token:
        return 0

    services = _fetch_gateway_services(agent_token)
    if services is None:
        return 0

    sgw_token = _find_sgw_token_for_host(services, host)
    if not sgw_token:
        return 0

    # Emit the credential in git-credential format. Never log or print elsewhere.
    sys.stdout.write("username=safeyolo\n")
    sys.stdout.write(f"password={sgw_token}\n")
    sys.stdout.write("\n")
    return 0


def main(argv: list[str]) -> int:
    verb = argv[1] if len(argv) >= 2 else "get"
    if verb == "get":
        return _handle_get()
    # store/erase: swallow git's key=value lines and no-op. Token lifecycle is
    # owned by the gateway; caching an sgw_ locally would drift on policy reload.
    _read_git_request()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
