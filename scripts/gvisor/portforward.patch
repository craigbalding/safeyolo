+
+type eofTestConn struct {
+	read       func([]byte, <-chan struct{}) (int, error)
+	write      func([]byte) (int, error)
+	closeWrite func() error
+	close      func()
+}
+
+func (*eofTestConn) Name() string { return "EOF test connection" }
+
+func (c *eofTestConn) Read(_ context.Context, buf []byte, cancel <-chan struct{}) (int, error) {
+	return c.read(buf, cancel)
+}
+
+func (c *eofTestConn) Write(_ context.Context, buf []byte, cancel <-chan struct{}) (int, error) {
+	select {
+	case <-cancel:
+		return 0, errProxyClosed
+	default:
+		return c.write(buf)
+	}
+}
+
+func (c *eofTestConn) CloseWrite(context.Context) error { return c.closeWrite() }
+func (c *eofTestConn) Close(context.Context)            { c.close() }
+
+func TestProxyResponseAfterEOF(t *testing.T) {
+	for _, reverse := range []bool{false, true} {
+		name := "from"
+		if reverse {
+			name = "to"
+		}
+		t.Run(name, func(t *testing.T) {
+			synctest.Test(t, func(t *testing.T) {
+				request := []byte("exec-half-close\n")
+				response := bytes.Repeat([]byte("reply-after-EOF\n"), 2048)
+				requestReader := bytes.NewReader(request)
+				responseReader := bytes.NewReader(response)
+				var receivedRequest, receivedResponse bytes.Buffer
+				inputEOF := make(chan struct{})
+				closed, outputEOF := 0, false
+				caller := &eofTestConn{
+					read: func(buf []byte, cancel <-chan struct{}) (int, error) {
+						select {
+						case <-cancel:
+							return 0, errProxyClosed
+						default:
+							return requestReader.Read(buf)
+						}
+					},
+					write: receivedResponse.Write,
+					closeWrite: func() error {
+						outputEOF = true
+						return nil
+					},
+					close: func() { closed++ },
+				}
+				origin := &eofTestConn{
+					read: func(buf []byte, cancel <-chan struct{}) (int, error) {
+						// The origin must receive EOF before producing any output.
+						select {
+						case <-cancel:
+							return 0, errProxyClosed
+						case <-inputEOF:
+							return responseReader.Read(buf)
+						}
+					},
+					write: receivedRequest.Write,
+					closeWrite: func() error {
+						close(inputEOF)
+						return nil
+					},
+					close: func() { closed++ },
+				}
+				pair := ProxyPair{To: origin, From: caller}
+				if reverse {
+					pair = ProxyPair{To: caller, From: origin}
+				}
+				proxy := NewProxy(pair, "EOF-control")
+				proxy.Start(context.Background())
+				defer proxy.Close()
+				synctest.Wait()
+				if !bytes.Equal(receivedRequest.Bytes(), request) || !bytes.Equal(receivedResponse.Bytes(), response) {
+					t.Fatalf("copied request/response = %d/%d bytes, want %d/%d", receivedRequest.Len(), receivedResponse.Len(), len(request), len(response))
+				}
+				if !outputEOF || closed != 2 {
+					t.Fatalf("output EOF = %t, closed connections = %d", outputEOF, closed)
+				}
+			})
+		})
+	}
+}
+
+func TestProxyErrorsCancelReverseCopy(t *testing.T) {
+	for _, operation := range []string{"read", "write", "write-EOF", "close-write"} {
+		t.Run(operation, func(t *testing.T) {
+			synctest.Test(t, func(t *testing.T) {
+				injected := errors.New("injected copy failure")
+				canceled, closed := false, 0
+				from := &eofTestConn{
+					read: func(buf []byte, _ <-chan struct{}) (int, error) {
+						switch operation {
+						case "read":
+							return 0, injected
+						case "close-write":
+							return 0, io.EOF
+						default:
+							buf[0] = 'x'
+							return 1, nil
+						}
+					},
+					close: func() { closed++ },
+				}
+				to := &eofTestConn{
+					read: func(_ []byte, cancel <-chan struct{}) (int, error) {
+						<-cancel
+						canceled = true
+						return 0, errProxyClosed
+					},
+					write: func([]byte) (int, error) {
+						if operation == "write-EOF" {
+							return 0, io.EOF
+						}
+						return 0, injected
+					},
+					closeWrite: func() error {
+						if operation != "close-write" {
+							t.Errorf("copy error %q was treated as orderly EOF", operation)
+							return nil
+						}
+						return injected
+					},
+					close: func() { closed++ },
+				}
+				proxy := NewProxy(ProxyPair{To: to, From: from}, "error-control")
+				proxy.Start(context.Background())
+				defer proxy.Close()
+				synctest.Wait()
+				if !canceled || closed != 2 {
+					t.Fatalf("reverse copy canceled = %t, closed connections = %d", canceled, closed)
+				}
+			})
+		})
+	}
+}
+
+func TestDoCopyPreservesBytesReturnedWithEOF(t *testing.T) {
+	ctx := context.Background()
+	var received bytes.Buffer
+	src := &eofTestConn{read: func(buf []byte, _ <-chan struct{}) (int, error) {
+		return copy(buf, "last bytes"), io.EOF
+	}}
+	dst := &eofTestConn{write: func(buf []byte) (int, error) {
+		return received.Write(buf[:1]) // Exercise short writes of the final data.
+	}}
+	err := doCopy(ctx, dst, src, make([]byte, 32), nil)
+	if err != io.EOF || received.String() != "last bytes" {
+		t.Fatalf("doCopy = %v, data = %q", err, received.String())
+	}
+}
