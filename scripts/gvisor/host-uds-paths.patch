+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package fsgofer
+
+import "testing"
+
+func TestHostUDSPathAllowed(t *testing.T) {
+	proxy := []string{"/safeyolo/proxy"}
+	for _, tc := range []struct {
+		name    string
+		allowed []string
+		path    string
+		want    bool
+	}{
+		{"unrestricted", nil, "/workspace/host.sock", true},
+		{"socket_below_entry", proxy, "/safeyolo/proxy/proxy.sock", true},
+		{"nested_below_entry", proxy, "/safeyolo/proxy/a/b.sock", true},
+		{"entry_itself", []string{"/run/one.sock"}, "/run/one.sock", true},
+		{"other_mount", proxy, "/workspace/host.sock", false},
+		{"sibling_with_shared_prefix", proxy, "/safeyolo/proxy-other/x.sock", false},
+		{"parent_of_entry", proxy, "/safeyolo/x.sock", false},
+		{"second_entry", []string{"/a", "/safeyolo/proxy"}, "/safeyolo/proxy/proxy.sock", true},
+		{"trailing_slash_entry", []string{"/safeyolo/proxy/"}, "/safeyolo/proxy/proxy.sock", true},
+		{"root_entry", []string{"/"}, "/workspace/host.sock", true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := hostUDSPathAllowed(tc.allowed, tc.path); got != tc.want {
+				t.Errorf("hostUDSPathAllowed(%q, %q) = %t, want %t", tc.allowed, tc.path, got, tc.want)
+			}
+		})
+	}
+}
