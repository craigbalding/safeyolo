+// GetHostUDSPaths returns the cleaned container paths that host-uds access is
+// restricted to. An empty result applies host-uds to every gofer mount.
+func (c *Config) GetHostUDSPaths() []string {
+	var paths []string
+	for _, entry := range strings.Split(c.HostUDSPaths, ",") {
+		if entry != "" {
+			paths = append(paths, filepath.Clean(entry))
+		}
+	}
+	return paths
+}
