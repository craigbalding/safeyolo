+
+package fsgofer
+
+import "strings"
+
+// hostUDSPathAllowed reports whether host Unix-domain socket access applies to
+// socketPath. An empty allowed list places no restriction beyond HostUDS.
+// Otherwise socketPath must equal an entry or lie below it; a sibling that
+// merely shares the entry's prefix does not match.
+func hostUDSPathAllowed(allowed []string, socketPath string) bool {
+	if len(allowed) == 0 {
+		return true
+	}
+	for _, entry := range allowed {
+		if entry == "/" || socketPath == entry || strings.HasPrefix(socketPath, strings.TrimSuffix(entry, "/")+"/") {
+			return true
+		}
+	}
+	return false
+}
