+package vfs
+
+import (
+	"testing"
+
+	"gvisor.dev/gvisor/pkg/context"
+	"gvisor.dev/gvisor/pkg/fspath"
+)
+
+func TestShouldFollowSymlinkDirectoryRequirement(t *testing.T) {
+	for _, tc := range []struct {
+		name, path              string
+		follow, directory, want bool
+	}{
+		{"final_nofollow", "link", false, false, false},
+		{"final_nofollow_directory", "link", false, true, false},
+		{"final_follow_directory", "link", true, true, true},
+		{"trailing_slash", "link/", false, false, true},
+		{"trailing_slash_directory", "link/", false, true, true},
+		{"nonfinal_nofollow", "link/child", false, true, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var vfs VirtualFilesystem
+			rp := vfs.getResolvingPath(nil, &PathOperation{
+				Path:               fspath.Parse(tc.path),
+				FollowFinalSymlink: tc.follow,
+			})
+			defer rp.Release(context.Background())
+			if tc.directory {
+				rp.mustBeDir = true // OpenAt's O_DIRECTORY type requirement.
+			}
+			if got := rp.ShouldFollowSymlink(); got != tc.want {
+				t.Errorf("ShouldFollowSymlink() = %t, want %t", got, tc.want)
+			}
+		})
+	}
+}
+
+func TestSymlinkTargetTrailingSlash(t *testing.T) {
+	for _, target := range []string{"target", "target/"} {
+		t.Run(target, func(t *testing.T) {
+			var vfs VirtualFilesystem
+			rp := vfs.getResolvingPath(nil, &PathOperation{Path: fspath.Parse("link")})
+			defer rp.Release(context.Background())
+			rp.Advance()
+			rp.relpathPrepend(fspath.Parse(target))
+			want := target == "target/"
+			if got := rp.ShouldFollowSymlink(); got != want {
+				t.Errorf("ShouldFollowSymlink() = %t, want %t", got, want)
+			}
+			if got := rp.MustBeDir(); got != want {
+				t.Errorf("MustBeDir() = %t, want %t", got, want)
+			}
+		})
+	}
+}
