[11.92, "o", "\u001b[2J\u001b[H\u001b[38;2;113;207;242mSafeYolo · 2  HOST CHANGES · HOST TERMINAL   ~/my-project\u001b[0m\r\n\r\n\u001b[38;2;113;207;242mREVIEW THE HOST CHANGES\u001b[0m\r\n\u001b[38;2;231;237;246m\u001b[0m\r\n\u001b[38;2;231;237;246mSafeYolo needs these host changes:\u001b[0m\r\n\u001b[38;2;165;180;200m  Install the runtime AppArmor profile.\u001b[0m\r\n\u001b[38;2;165;180;200m  Prepare the namespace entry and its AppArmor profile.\u001b[0m\r\n\u001b[38;2;165;180;200m  Allow the selected sandbox UID to access the runtime files.\u001b[0m\r\n\u001b[38;2;231;237;246m\u001b[0m\r\n\u001b[38;2;244;198;125mOnly the listed host operations use sudo.\u001b[0m\r\n\u001b[38;2;165;180;200mThe proxy and agent run as your ordinary account.\u001b[0m\r\n\u001b[38;2;231;237;246m\u001b[0m\r\n\u001b[38;2;114;132;157mHost-specific paths and repeated details are shortened in this preview.\u001b[0m\r\n\u001b[38;2;231;237;246m\u001b[0m\r\n\u001b[38;2;231;237;246mAllow these host changes? [y/N] \u001b[0m\r\n\u001b[38;2;116;224;176my\u001b[0m\r\n\r\n\u001b[38;2;114;132;157mEdited walkthrough · waits shortened · existing host login · not a benchmark\u001b[0m"]
[12.52, "o", "\u001b[2J\u001b[H\u001b[38;2;113;207;242mSafeYolo · 3  SHARE & SIGN IN · HOST TERMINAL   ~/my-project\u001b[0m\r\n\r\n\u001b[38;2;165;180;200mSafeYolo: preparing the verified guest cache while acquiring the host package.\u001b[0m\r\n\u001b[38;2;165;180;200mSafeYolo: acquiring and verifying the compatible guest.\u001b[0m\r\n\u001b[38;2;165;180;200mSafeYolo: initializing configuration, identity and trust.\u001b[0m\r\n\u001b[38;2;165;180;200mSafeYolo: activating the verified installation at ~/.safeyolo.\u001b[0m\r\n\u001b[38;2;231;237;246m\u001b[0m\r\n\u001b[38;2;113;207;242mCHOOSE WHAT TO SHARE\u001b[0m\r\n\u001b[38;2;231;237;246m\u001b[0m\r\n\u001b[38;2;231;237;246mProject: ~/my-project  →  /workspace\u001b[0m\r\n\u001b[38;2;244;198;125mThe guest can read and write files in this project.\u001b[0m\r\n\u001b[38;2;165;180;200mSetup creates the agent home and writes its SafeYolo and MCP settings.\u001b[0m\r\n\u001b[38;2;244;198;125mCodex may run tools without per-tool prompts inside the sandbox.\u001b[0m\r\n\u001b[38;2;231;237;246m\u001b[0m\r\n\u001b[38;2;231;237;246mRun this setup and share this workspace? [y/N]\u001b[0m\r\n\r\n\u001b[38;2;114;132;157mEdited walkthrough · waits shortened · existing host login · not a benchmark\u001b[0m"]
